# Copy to .env and edit. Wikimedia asks clients to identify themselves with
# a descriptive User-Agent that includes a way to contact you.
WIKI_USER_AGENT="kafka-wikimedia-pipeline/0.1 (https://github.com/fowlestravis/kafka-wikimedia-pipeline)"

# Kafka broker(s) and topic for src/producer.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=recentchange
